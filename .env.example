APP_NAME=Sabbalens API
DEBUG=true

# Database (PostgreSQL for Docker, SQLite fallback for local test/dev)
POSTGRES_USER=sabbalens
POSTGRES_PASSWORD=sabbalens
POSTGRES_DB=sabbalens
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://sabbalens:sabbalens@localhost:5434/sabbalens
# SQLite fallback: DATABASE_URL=sqlite:///./data/sabbalens.db

UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=10485760
NOMINATIM_USER_AGENT=sabbalens_photo_scheduler
NOMINATIM_RATE_LIMIT=1.0

# Telegram Bot Publishing
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=@my_photo_channel
TELEGRAM_PARSE_MODE=HTML
SIMULATE_SOCIAL_PUBLISH=true

# Legacy Instagram (Optional)
PUBLIC_BASE_URL=https://api.sabbalens.me
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_REDIRECT_URI=https://api.sabbalens.me/api/v1/auth/instagram/callback